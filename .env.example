# Copy to .env and fill in. .env is gitignored - this repository is public.

# --- AI33 / OpenSpeaker (optional, PAID) ----------------------------------
# Powers the "ai33" voiceover provider: a large voice library (ElevenLabs,
# Minimax, Edge, Fish Audio) with native word-level timings. Credit-based:
# measured 110 credits for a 77-character, two-sentence narration with an
# ElevenLabs voice (about 1.4 credits per character). Never selected by default -
# Kokoro stays the free local default.
# Key from https://ai33.pro -> API Key
AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro
